# ==============================================================================
# MEDMATCH AI — FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Safe client-side environment variables only.
# CRITICAL: NEVER place private keys, seeds, or mnemonics in the frontend environment.
# ==============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEMO_MODE=false

# Public Firebase Configuration (Optional Web Client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=medmatch-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=medmatch-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=medmatch-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
