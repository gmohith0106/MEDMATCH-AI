# ==============================================================================
# MEDMATCH AI — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure your Algorand TestNet wallet.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your real .env file with private mnemonics to version control.
# 2. NEVER expose backend private keys or credentials to frontend source code.
# ==============================================================================

# Core Wallet & x402 Protocol Roles
# Account 1 (Payer Signer): Signs x402 supplier intelligence payments
AVM_MNEMONIC=

# Account 2 (Receiver): Receives 0.02 USDC payments on Algorand TestNet
AVM_ADDRESS=

# x402 Protocol Facilitator & Pricing
FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_PAYMENT_PRICE=0.02
PORT=4000

# Server & Network Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PAYMENT_MODE=x402
ALGORAND_MODE=real
DEMO_MODE=false

# Algorand TestNet Nodes
ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDe
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_EXPLORER_BASE_URL=https://lora.algokit.io/testnet/transaction

# Aliases
ALGORAND_RECEIVER_ADDRESS=
ALGORAND_SENDER_MNEMONIC=
X402_ENDPOINT=/api/paid/supplier-intelligence
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_PAYMENT_AMOUNT=$0.02
X402_PAYMENT_ASSET=USDC

# Optional Firebase Service Account
FIREBASE_PROJECT_ID=medmatch-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
